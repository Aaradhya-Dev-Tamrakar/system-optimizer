<UserControl x:Class="NovaOptimizer.Views.TurboBoostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="900">
            <!-- Header section -->
            <TextBlock Text="TURBO BOOST &amp; RAM OPTIMIZER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,4"/>
            <TextBlock Text="System Acceleration Profiles" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
            <TextBlock Text="Select a mode to suppress unnecessary background telemetry, optimize RAM allocation, and prevent micro-stutters." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,24"/>

            <!-- Main Profiles Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Game Boost Card -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="38" Height="38" CornerRadius="8" Background="#2B1A3A" Margin="0,0,10,0">
                                <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Game Boost" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Maximum FPS &amp; Zero Stutter" FontSize="11" Foreground="{StaticResource AccentPurple}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Suspends Windows Search indexer, telemetry (DiagTrack), and SysMain. Unconstrains CPU power plan to High Performance, and clears Standby RAM cache." 
                                   TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                        <StackPanel Grid.Row="2" Margin="0,0,0,14">
                            <TextBlock Text="• Telemetry &amp; Error Reporting paused" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                            <TextBlock Text="• SuperFetch &amp; Search Indexing suspended" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                            <TextBlock Text="• Standby memory purged" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                            <TextBlock Text="• Ultimate/High Power Plan engaged" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                        </StackPanel>

                        <Button x:Name="BtnGameBoost" Grid.Row="3" Content="Activate Game Boost" Style="{StaticResource PrimaryButton}" 
                                Background="{StaticResource AccentPurple}" Foreground="White" Click="BtnGameBoost_Click"/>
                    </Grid>
                </Border>

                <!-- Work Boost Card -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="38" Height="38" CornerRadius="8" Background="#142B38" Margin="0,0,10,0">
                                <TextBlock Text="💼" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Work / Dev Boost" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Optimized for IDEs &amp; Creativity" FontSize="11" Foreground="{StaticResource AccentCyan}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Trims dormant background applications, suppresses gaming Xbox background hooks, cleans Standby Cache, and devotes maximum physical RAM to development and creative suites." 
                                   TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                        <StackPanel Grid.Row="2" Margin="0,0,0,14">
                            <TextBlock Text="• Working sets trimmed across idle apps" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                            <TextBlock Text="• Xbox background services suppressed" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                            <TextBlock Text="• File cache &amp; Standby list cleared" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                            <TextBlock Text="• Prioritizes foreground workspace windows" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                        </StackPanel>

                        <Button x:Name="BtnWorkBoost" Grid.Row="3" Content="Activate Work Boost" Style="{StaticResource PrimaryButton}" 
                                Background="{StaticResource AccentCyan}" Foreground="#0D0E12" Click="BtnWorkBoost_Click"/>
                    </Grid>
                </Border>

                <!-- Study Mode Card -->
                <Border Grid.Column="4" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="38" Height="38" CornerRadius="8" Background="#152744" Margin="0,0,10,0">
                                <TextBlock Text="📚" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Study Mode" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Deep Focus &amp; Distraction Free" FontSize="11" Foreground="{StaticResource AccentBlue}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Description -->
                        <TextBlock Grid.Row="1" Text="Kills distracting entertainment processes (Discord, Spotify, Steam), silences background telemetry &amp; indexing, sets Balanced power for quiet fans, and features an integrated Pomodoro timer." 
                                   TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                        <!-- Bullet points -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,14">
                            <TextBlock Text="• Distraction apps terminated (Discord, Spotify, Steam)" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                            <TextBlock Text="• Balanced power plan (cool, quiet sustained session)" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                            <TextBlock Text="• Telemetry, SuperFetch &amp; Xbox paused" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                            <TextBlock Text="• Standby cache purged for maximum free RAM" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                        </StackPanel>

                        <!-- Activate Button -->
                        <Button x:Name="BtnStudyMode" Grid.Row="3" Content="Activate Study Mode" Style="{StaticResource PrimaryButton}" 
                                Background="{StaticResource AccentBlue}" Foreground="White" Margin="0,0,0,14" Click="BtnStudyMode_Click"/>

                        <!-- Built-in Pomodoro Focus Box -->
                        <Border Grid.Row="4" Background="#101422" BorderBrush="#1F2A45" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtPomodoroPhase" Text="📖 Focus Session" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                                    <TextBlock x:Name="TxtPomodoroCounter" Text="Session #1" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Countdown Display -->
                                <TextBlock x:Name="TxtPomodoroCountdown" Text="25:00" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,8"/>

                                <!-- Duration Inputs (Focus & Break) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Focus (m)" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtFocusMins" Text="25" Style="{StaticResource DarkTextBox}" FontSize="11" Padding="6,3" HorizontalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Break (m)" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtBreakMins" Text="5" Style="{StaticResource DarkTextBox}" FontSize="11" Padding="6,3" HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Controls -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="BtnPomodoroToggle" Grid.Column="0" Content="▶ Start Timer" Style="{StaticResource PrimaryButton}" 
                                            Background="#1E3A5F" Foreground="{StaticResource AccentBlue}" FontSize="11" Padding="8,4" Click="BtnPomodoroToggle_Click"/>
                                    <Button x:Name="BtnPomodoroReset" Grid.Column="2" Content="↺ Reset" Style="{StaticResource SecondaryButton}" 
                                            FontSize="11" Padding="6,4" Click="BtnPomodoroReset_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Memory Breakdown & Deep Purge Card -->
            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="PHYSICAL MEMORY BREAKDOWN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,4"/>
                            <TextBlock Text="Real-Time RAM Allocation" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <Button x:Name="BtnDeepClean" Content="🧹 Deep RAM Purge Now" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" 
                                Background="{StaticResource AccentGreen}" Foreground="#0D0E12" Click="BtnDeepClean_Click"/>
                    </Grid>

                    <!-- Multi-Segment Visual Progress Bar -->
                    <Border Height="20" CornerRadius="6" Background="#14161F" Margin="0,0,0,12" ClipToBounds="True">
                        <Grid x:Name="RamBarContainer">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColInUse" Width="45*"/>
                                <ColumnDefinition x:Name="ColStandby" Width="25*"/>
                                <ColumnDefinition x:Name="ColFree" Width="30*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource AccentCyan}" ToolTip="In-Use Memory"/>
                            <Border Grid.Column="1" Background="{StaticResource AccentPurple}" ToolTip="Standby Cache"/>
                            <Border Grid.Column="2" Background="{StaticResource AccentGreen}" ToolTip="Free Memory"/>
                        </Grid>
                    </Border>

                    <!-- Legend -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- In Use -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource AccentCyan}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="In Use" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtInUse" Text="7.2 GB (45%)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Standby -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource AccentPurple}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Standby Cache" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtStandby" Text="4.1 GB (25%)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Free -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource AccentGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Free Unallocated" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtFree" Text="4.7 GB (30%)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Auto-RAM Watchdog & Log Card -->
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="INTELLIGENT WATCHDOG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" Margin="0,0,0,4"/>
                            <TextBlock Text="Silent Background Memory Cleaner" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkAutoClean" Content="Enable Auto-Watchdog" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                                  VerticalAlignment="Center" HorizontalAlignment="Right" Checked="ChkAutoClean_Changed" Unchecked="ChkAutoClean_Changed"/>
                    </Grid>

                    <TextBlock Text="When enabled, NovaOptimizer silently purges the Standby Cache whenever In-Use RAM exceeds 85% or Standby cache exceeds 3.0 GB, preventing hitching in games or heavy compiles." 
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <!-- Activity Log -->
                    <TextBlock Text="Recent Optimization Activity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <Border Background="#12131A" CornerRadius="6" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" Height="110" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtActivityLog" Text="[Ready] NovaOptimizer loaded with Kernel Standby Purge and Working Set Trimmer." 
                                       FontFamily="Consolas, monospace" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
