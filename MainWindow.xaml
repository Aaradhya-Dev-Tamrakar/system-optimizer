<Window x:Class="NovaOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NovaOptimizer — System Optimizer &amp; Task Manager" 
        Icon="Assets/icon.png"
        Height="760" Width="1180" MinHeight="640" MinWidth="980"
        Background="{StaticResource BgDark}" WindowStartupLocation="CenterScreen"
        BorderBrush="{StaticResource BorderCard}" BorderThickness="1">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Custom Titlebar -->
        <Border Grid.Row="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderCard}" BorderThickness="0,0,0,1" Padding="16,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/icon.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="NOVA OPTIMIZER" FontSize="14" FontWeight="Black" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border CornerRadius="4" Background="{StaticResource BadgeBgPrimary}" BorderBrush="{StaticResource BadgeBorderPrimary}" BorderThickness="1" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="PRO v1.0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}"/>
                    </Border>
                </StackPanel>

                <!-- Central Floating Toast Notification Banner -->
                <Border x:Name="ToastBanner" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource BadgeBgPrimary}" BorderBrush="{StaticResource AccentPrimary}" BorderThickness="1"
                        CornerRadius="20" Padding="14,5" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtToastIcon" Text="⚡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtNotification" Text="System Ready" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Header Actions & Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Live RAM Indicator Badge -->
                    <Border CornerRadius="6" Background="{StaticResource BgCardSubtle}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" Padding="10,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💾 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtHeaderRam" Text="RAM: 45%" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Instant Quick Clean Button -->
                    <Button x:Name="BtnQuickClean" Content="⚡ Quick Clean" Style="{StaticResource PrimaryButton}" 
                            Padding="12,5" FontSize="11.5" Margin="0,0,10,0" Click="BtnQuickClean_Click"/>

                    <!-- Active Mode Badge -->
                    <Border x:Name="BadgeMode" CornerRadius="6" Background="{StaticResource BadgeBgDefault}" BorderBrush="{StaticResource BadgeBorderDefault}" BorderThickness="1" Padding="8,5" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtBadgeMode" Text="🚀 Standard" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentPurple}"/>
                    </Border>

                    <!-- Admin Badge -->
                    <Border CornerRadius="6" Background="{StaticResource BadgeBgSuccess}" BorderBrush="{StaticResource BadgeBorderSuccess}" BorderThickness="1" Padding="7,4" Margin="0,0,14,0">
                        <TextBlock Text="🛡️ Admin" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"/>
                    </Border>

                    <!-- Window Control Buttons (Min, Max, Close) -->
                    <Button Content="—" Style="{StaticResource WindowControlBtn}" Click="BtnMinimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="BtnMaximize" Content="□" Style="{StaticResource WindowControlBtn}" Click="BtnMaximize_Click" ToolTip="Maximize"/>
                    <Button Content="✕" Style="{StaticResource WindowCloseBtn}" Click="BtnClose_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace: Sidebar Navigation + Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderCard}" BorderThickness="0,0,1,0">
                <Grid Margin="12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="8,0,0,10"/>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavBoost" Content="⚡ Turbo Boost" IsChecked="True" Style="{StaticResource NavRadioButton}" 
                                     Click="Nav_Click" Tag="Boost"/>

                        <RadioButton x:Name="NavProcesses" Content="📋 Task Manager" Style="{StaticResource NavRadioButton}" 
                                     Click="Nav_Click" Tag="Processes"/>

                        <RadioButton x:Name="NavPerformance" Content="📊 Performance" Style="{StaticResource NavRadioButton}" 
                                     Click="Nav_Click" Tag="Performance"/>

                        <RadioButton x:Name="NavTweaks" Content="⚙️ Startup &amp; Tweaks" Style="{StaticResource NavRadioButton}" 
                                     Click="Nav_Click" Tag="Tweaks"/>

                        <RadioButton x:Name="NavHungLog" Style="{StaticResource NavRadioButton}" Click="Nav_Click" Tag="HungLog">
                            <Grid HorizontalAlignment="Stretch">
                                <TextBlock Text="🔍 Hung Log" VerticalAlignment="Center"/>
                                <Border x:Name="BadgeHungCount" CornerRadius="8" Background="{StaticResource AccentRed}" Padding="5,1" 
                                        HorizontalAlignment="Right" Margin="0,0,4,0" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtHungBadge" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom Pinned Telemetry & Tray Card -->
                    <Border Grid.Row="2" Background="{StaticResource BgCardSubtle}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Zero Latency Active" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                            </StackPanel>
                            <TextBlock Text="Kernel Standby Cleaner &amp; Watchdog actively protecting framerates." FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to tray" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                      IsChecked="True"/>
                            <CheckBox x:Name="ChkStartWithWindows" Content="Start with Windows" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                      Margin="0,6,0,0" Checked="ChkStartWithWindows_Changed" Unchecked="ChkStartWithWindows_Changed"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ContentControl x:Name="MainContent" Grid.Column="1" Background="{StaticResource BgDark}"/>
        </Grid>
    </Grid>
</Window>
