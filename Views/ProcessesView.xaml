<UserControl x:Class="NovaOptimizer.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="LIVE SYSTEM AUDITOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,4"/>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Running Processes" FontSize="26" FontWeight="Black" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>

            <!-- Action Buttons Toolbar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnEndTask" Content="❌ End Task" Style="{StaticResource DangerButton}" Click="BtnEndTask_Click" Margin="0,0,8,0" Padding="12,6"/>
                <Button x:Name="BtnTrimProcess" Content="🧹 Trim RAM" Style="{StaticResource SecondaryButton}" Click="BtnTrimProcess_Click" Margin="0,0,8,0" Padding="12,6"/>
                <Button x:Name="BtnRefresh" Content="↺ Refresh" Style="{StaticResource SecondaryButton}" Click="BtnRefresh_Click" Padding="10,6"/>
            </StackPanel>
        </Grid>

        <!-- Search & Filter Chips Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Filter Chips -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="All" Tag="All" IsChecked="True" Style="{StaticResource FilterChip}" Click="FilterChip_Click"/>
                <RadioButton Content="🪟 Apps" Tag="Apps" Style="{StaticResource FilterChip}" Click="FilterChip_Click"/>
                <RadioButton Content="⚙️ Background" Tag="Background" Style="{StaticResource FilterChip}" Click="FilterChip_Click"/>
                <RadioButton Content="💾 High RAM (&gt;500MB)" Tag="HighRam" Style="{StaticResource FilterChip}" Click="FilterChip_Click"/>
                <RadioButton Content="⚡ High CPU (&gt;5%)" Tag="HighCpu" Style="{StaticResource FilterChip}" Click="FilterChip_Click"/>
                <RadioButton Content="⚠️ Hung" Tag="Hung" Style="{StaticResource FilterChip}" Click="FilterChip_Click"/>
            </StackPanel>

            <!-- Search Box with Clear Button -->
            <Grid Grid.Column="1" HorizontalAlignment="Right" Width="260">
                <TextBox x:Name="TxtSearch" Style="{StaticResource DarkTextBox}" Padding="28,6,26,6"
                         TextChanged="TxtSearch_TextChanged"/>
                <TextBlock Text="🔍" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" 
                           HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="TxtPlaceholder" Text="Search name, PID, desc..." FontSize="12" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="28,0,0,0" IsHitTestVisible="False"/>
                <Button x:Name="BtnClearSearch" Content="✕" FontSize="10" Foreground="{StaticResource TextMuted}" Background="Transparent"
                        BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                        Width="20" Height="20" Cursor="Hand" Click="BtnClearSearch_Click" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- Processes DataGrid -->
        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Padding="0">
            <DataGrid x:Name="DgProcesses" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0" RowBackground="{StaticResource BgCard}" AlternatingRowBackground="{StaticResource BgCardSubtle}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderCard}"
                      Foreground="{StaticResource TextPrimary}" HeadersVisibility="Column" SelectionMode="Single"
                      CanUserSortColumns="True" SelectionChanged="DgProcesses_SelectionChanged"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BgSidebar}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderCard}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgCardHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource BadgeBgPrimary}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.ContextMenu>
                    <ContextMenu Background="{StaticResource BgCardHover}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderCard}">
                        <MenuItem Header="❌ End Task" Click="MenuEndTask_Click"/>
                        <MenuItem Header="⚡ Kill Process Tree" Click="MenuKillTree_Click"/>
                        <Separator Background="{StaticResource BorderCard}"/>
                        <MenuItem Header="🧹 Trim Working Set (Clean RAM)" Click="MenuTrimRam_Click"/>
                        <MenuItem Header="📈 Set Priority">
                            <MenuItem Header="Realtime" Click="MenuPriority_Click" Tag="Realtime"/>
                            <MenuItem Header="High" Click="MenuPriority_Click" Tag="High"/>
                            <MenuItem Header="Above Normal" Click="MenuPriority_Click" Tag="AboveNormal"/>
                            <MenuItem Header="Normal" Click="MenuPriority_Click" Tag="Normal"/>
                            <MenuItem Header="Below Normal" Click="MenuPriority_Click" Tag="BelowNormal"/>
                            <MenuItem Header="Idle" Click="MenuPriority_Click" Tag="Idle"/>
                        </MenuItem>
                        <Separator Background="{StaticResource BorderCard}"/>
                        <MenuItem Header="📂 Open File Location" Click="MenuOpenLocation_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <!-- Process Name with Process Icon -->
                    <DataGridTemplateColumn Header="Process Name" Width="220" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="75"/>
                    <DataGridTextColumn Header="RAM (MB)" Binding="{Binding DisplayRam}" Width="110"/>
                    <DataGridTextColumn Header="CPU %" Binding="{Binding DisplayCpu}" Width="85"/>
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="95"/>
                    
                    <!-- Status with Status Dot -->
                    <DataGridTemplateColumn Header="Status" Width="105" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                    <!-- Green dot if Running, Red dot if Not Responding -->
                                    <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHung}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentRed}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHung}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer status -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" Text="Processes: 0" FontSize="12" Foreground="{StaticResource TextMuted}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Tip: Right-click any process for tree termination, memory trim, and priority class." FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
