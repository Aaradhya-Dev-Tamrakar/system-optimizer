<Window x:Class="NovaOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NovaOptimizer — System Optimizer &amp; Task Manager" 
        Icon="Assets/icon.png"
        Height="740" Width="1160" MinHeight="620" MinWidth="960"
        Background="{StaticResource BgDark}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#14161F" BorderBrush="{StaticResource BorderCard}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/icon.png" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="NOVA OPTIMIZER" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border CornerRadius="4" Background="#1F2433" Margin="8,0,0,0" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="v1.0 HIGH-PERF" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                    </Border>
                </StackPanel>

                <!-- Status Toast Notification Message -->
                <TextBlock x:Name="TxtNotification" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" Text=""/>

                <!-- Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Live RAM Indicator -->
                    <Border CornerRadius="6" Background="#1B1E29" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" Padding="10,5" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " FontSize="12"/>
                            <TextBlock x:Name="TxtHeaderRam" Text="RAM: 45%" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Instant Quick Clean Button -->
                    <Button x:Name="BtnQuickClean" Content="⚡ Quick Clean" Style="{StaticResource PrimaryButton}" 
                            Padding="12,6" FontSize="12" Margin="0,0,12,0" Click="BtnQuickClean_Click"/>

                    <!-- Mode Badge -->
                    <Border x:Name="BadgeMode" CornerRadius="6" Background="#241B33" Padding="10,5" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtBadgeMode" Text="🚀 Standard" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentPurple}"/>
                    </Border>

                    <!-- Administrator Badge -->
                    <Border CornerRadius="6" Background="#142B28" Padding="8,5">
                        <TextBlock Text="🛡️ Administrator" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Sidebar Navigation + Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderCard}" BorderThickness="0,0,1,0" Padding="12,16">
                <StackPanel>
                    <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="12,0,0,10"/>

                    <RadioButton x:Name="NavBoost" Content="⚡ Turbo Boost" IsChecked="True" Style="{x:Null}" 
                                 Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" Margin="0,2" Padding="14,10"
                                 Cursor="Hand" Click="Nav_Click" Tag="Boost"/>

                    <RadioButton x:Name="NavProcesses" Content="📋 Processes" Style="{x:Null}" 
                                 Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" Margin="0,2" Padding="14,10"
                                 Cursor="Hand" Click="Nav_Click" Tag="Processes"/>

                    <RadioButton x:Name="NavPerformance" Content="📊 Performance" Style="{x:Null}" 
                                 Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" Margin="0,2" Padding="14,10"
                                 Cursor="Hand" Click="Nav_Click" Tag="Performance"/>

                    <RadioButton x:Name="NavTweaks" Content="⚙️ Startup &amp; Tweaks" Style="{x:Null}" 
                                 Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" Margin="0,2" Padding="14,10"
                                 Cursor="Hand" Click="Nav_Click" Tag="Tweaks"/>

                    <RadioButton x:Name="NavHungLog" Content="🔍 Hung Log" Style="{x:Null}" 
                                 Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" Margin="0,2" Padding="14,10"
                                 Cursor="Hand" Click="Nav_Click" Tag="HungLog"/>

                    <!-- Footer Info in Sidebar -->
                    <Border Margin="4,220,4,0" Background="#10121A" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Zero Latency Mode" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                            <TextBlock Text="Kernel Standby Cleaner &amp; Service Throttler active." FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Main Content Area -->
            <ContentControl x:Name="MainContent" Grid.Column="1" Background="{StaticResource BgDark}"/>
        </Grid>
    </Grid>
</Window>
